# Apptainer counterpart of Containerfile.gpu: layer the GPU-traced sysimage
# onto the published TJLFEP SIF for local (e.g. Defiant) use. Build from the
# directory holding sys_tglfep_julia_gpu.so:
#
#   apptainer build --build-arg BASE_SIF=$WORK/tglfep_julia_v2.0.14.sif \
#       tglfep_julia_v2.0.14-gpu.sif /path/to/gpu-sysimage/tglfep_julia_gpu.def
#
# The tglfep_julia launcher picks the sysimage up automatically at this path.
# The PUBLISHED :<v>-gpu OCI tag is produced separately (crane append or
# Containerfile.gpu) so podman/docker sites get the identical layer.

Bootstrap: localimage
From: {{ BASE_SIF }}

%arguments
    BASE_SIF=tglfep_julia.sif

%files
    sys_tglfep_julia_gpu.so /opt/tglfep_julia/sys_tglfep_julia_gpu.so
